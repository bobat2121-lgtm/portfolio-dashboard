# Copy to .env for local runs (never committed). The same names go into GitHub Actions secrets
# and Streamlit Cloud secrets.

# Postgres (Neon). Leave empty locally to use data/portfolio.db (SQLite).
DATABASE_URL=

# SnapTrade Personal key: dashboard.snaptrade.com -> API keys. Covers Fidelity + Robinhood.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Kraken API key with ONLY "Query Funds" and "Query Ledger Entries" ticked.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Password for the dashboard. Leave empty locally; always set it on Streamlit Cloud.
APP_PASSWORD=
