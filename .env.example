# Copy to .env for local runs. .env is gitignored and never leaves your PC.
# Never paste these values into chats, issues or code.

# Neon owner connection string (Neon -> project -> Connect, pooling OFF).
DATABASE_URL=
# Written for you by `python -m jobs.readonly_login`; goes into Streamlit secrets as DATABASE_URL.
# DATABASE_URL_READONLY=

# SnapTrade Personal key: dashboard.snaptrade.com/api-key
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Kraken key with ONLY "Query Funds" and "Query Ledger Entries" ticked.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Optional private config (account pins, cost-basis overrides), YAML. See config/portfolio.yaml.
# PORTFOLIO_CONFIG=

# Only needed if you run the dashboard locally against Neon (16+ characters).
APP_PASSWORD=
