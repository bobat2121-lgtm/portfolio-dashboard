# Streamlit Cloud -> your app -> Settings -> Secrets. Only these two. No broker keys ever go here.
DATABASE_URL = "the DATABASE_URL_READONLY value from your .env (read-only login)"
APP_PASSWORD = "a long random password: python -c \"import secrets; print(secrets.token_urlsafe(24))\""
# Optional: changing this signs out every browser that ticked "Remember this browser" (so does a new APP_PASSWORD).
# AUTH_SECRET = "another long random value"
